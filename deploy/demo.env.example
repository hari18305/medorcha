# Copy to .env.demo (gitignored) and fill in. The Gemini key etc. stay in the normal .env.
DEMO_USER=judge
# Make the hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext "the-password-you-will-share"
# NOTE: in this file write each "$" in the hash as "$$" so compose does not treat it as a variable.
DEMO_PASSWORD_HASH=
# ":80" for laptop + tunnel; a domain name (demo.example.com) on a VM to get https automatically.
SITE_ADDRESS=:80
DEMO_PORT=8080
DEMO_MAX_PER_IP_HOUR=6
DEMO_MAX_CASES_TOTAL=150
DEMO_MAX_UPLOAD_MB=8
