# One address for everything. SITE_ADDRESS is ":80" for a laptop/tunnel (the tunnel supplies https) or a domain name
# (e.g. demo.example.com) on a VM, in which case Caddy gets a certificate automatically.
{$SITE_ADDRESS::80} {
	encode gzip

	# Shared demo password (hash made with: caddy hash-password). /health stays open for uptime checks.
	@protected not path /health
	basic_auth @protected {
		{$DEMO_USER:judge} {$DEMO_PASSWORD_HASH}
	}

	# Hard upload ceiling at the door (the backend guard enforces the friendlier 8 MB message first).
	request_body {
		max_size 10MB
	}

	# /api/diagnose -> backend /diagnose. Caddy overwrites any client-supplied X-Forwarded-For with the real address.
	handle_path /api/* {
		reverse_proxy backend:8000 {
			# a case takes under a minute; allow generous headroom for the synchronous call
			transport http {
				response_header_timeout 300s
			}
		}
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
