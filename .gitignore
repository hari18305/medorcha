backend/tests/evaluation_report.md
backend/tests/evaluation_report.csv

# Env
.env

# Node
node_modules/

# Frontend build
frontend/dist/
frontend/build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# User-uploaded images from POST /diagnose (runtime artifact, not source)
data/images/uploads/

# Stray install logs
install.log
pip-log.txt

# Editor/session-local state (not project source)
.claude/
HANDOFF.md

# Evaluation run logs and intermediate per-run outputs (point-in-time,
# regenerate with backend/tests/run_evaluation.py). The three *_final*
# markdown reports are force-added as the recorded results snapshots.
backend/tests/*.log
backend/tests/eval_*.csv
backend/tests/eval_*.md
backend/tests/mode2_items.csv
