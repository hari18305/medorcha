venv/
__pycache__/
*.pyc
.pytest_cache/
*.db

# Local embedded Qdrant storage (fallback when QDRANT_URL is unset)
data/qdrant_local/

# Rotating structured log file (backend/services/logging.py)
logs/

# Generated evaluation reports (backend/tests/run_evaluation.py) --
