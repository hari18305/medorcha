# Which LLM surface to use -- "anthropic" (default), "bedrock",
# "vertex", "gemini", "mistral". See backend/services/llm_client.py
# and the README's "Switching LLM provider" section.
#
# anthropic/bedrock/vertex are all genuinely Claude, just different
# cloud auth/billing paths. gemini/mistral are genuinely different
# model vendors -- fine as a functional fallback, but a materially
# different claim than "this uses Claude" if that matters for how you
# present the project.
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic (the default).
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=bedrock. Standard boto3 env vars -- also
# picked up automatically if you've run `aws configure` instead.
# Requires: pip install boto3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Required if LLM_PROVIDER=vertex. GOOGLE_APPLICATION_CREDENTIALS is a
# path to a service account JSON key file.
# Requires: pip install google-auth google-cloud-aiplatform
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5
GOOGLE_APPLICATION_CREDENTIALS=

# Required if LLM_PROVIDER=gemini. Free-tier key from
# aistudio.google.com -- no billing/cloud account needed.
# google-genai is already in requirements.txt (this project's actual
# working provider as of 2026-08, not just a fallback).
GEMINI_API_KEY=
# Free-tier requests-per-minute budget this process self-throttles to
# (see backend/services/llm_client.py) -- lower this if you still see
# 429s, raise it if you're on a paid tier with more headroom.
GEMINI_RPM_BUDGET=12

# Required if LLM_PROVIDER=mistral. Free-tier key from
# console.mistral.ai.
# Requires: pip install mistralai litellm
# (litellm is specifically for CrewAI's orchestration layer -- Mistral
# isn't one of CrewAI's natively-bundled providers the way the others
# are; see llm_client.py's module docstring)
MISTRAL_API_KEY=

# Override only if your account's console shows a different exact
# model ID than this file's default for your chosen provider (see
# backend/services/llm_client.py for the defaults).
ANTHROPIC_CLAUDE_MODEL_ID=
BEDROCK_CLAUDE_MODEL_ID=
VERTEX_CLAUDE_MODEL_ID=
# Leave GEMINI_MODEL_ID unset to use the code's default, gemini-3.5-flash-lite.
# Do NOT set it to gemini-3.6-flash on a free tier: its free quota is 20
# requests PER DAY (confirmed live -- one case exhausts it and the next call
# returns 429), where flash-lite's is far more generous.
GEMINI_MODEL_ID=
MISTRAL_MODEL_ID=

QDRANT_URL=
QDRANT_API_KEY=
PUBMED_API_KEY=
DATABASE_URL=sqlite:///./medorchestrate.db

# Case-memory retrieval cutoffs (Phase 13). A past clinician override is
# only surfaced as a precedent if it is at least this similar. Text:
# measured with the real BioBERT model (similar cases ~0.75-0.81, unrelated
# ~0.2-0.3). Visual: an UNVALIDATED prototype default (synthetic images
# can't calibrate it); precedents are also restricted to the same
# imaging modality. Leave unset to use these defaults.
CASE_MEMORY_MIN_SCORE=0.6
VISUAL_MEMORY_MIN_SCORE=0.85

# Reranker score calibration (backend/rag/reranker.py): the cross-encoder's
# raw logit is mapped to a 0-1 relevance score (the S_rag confidence signal)
# as sigmoid((logit - CENTER) / SCALE). Hand-calibrated prototype values for
# the current knowledge base -- re-check with
# `python -m backend.rag.calibrate_reranker` if the corpus or model changes.
RERANK_SCORE_CENTER=-7
RERANK_SCORE_SCALE=2

# PubMed abstract summaries: off = the abstract is truncated (no LLM call).
# On = one LLM call per abstract (5 per query, again on every optimizer
# iteration), run concurrently under a 12s budget. Leave OFF on a free tier --
# it spends most of the daily quota for a marginal readability gain.
EVIDENCE_LLM_SUMMARIES=false

# Optional LLM observability (backend/services/logging.py). Off by
# default -- the app runs identically without any of these set.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Imaging: a finding label BEYOND the top one is reported only if it is at least
# this fraction as strong as the top label (and clears a 0.15 floor). Scores are
# a softmax, so a decisive top label leaves little for the rest and a weak
# secondary is usually noise (a real pneumothorax film once reported a spurious
# "rib fracture" this way). Prototype value from a handful of images.
FINDING_RELATIVE_THRESHOLD=0.6
